// C:\Projects\Training\2023 UI training\ResourceTrackerV2\AppSrc\SelectProject.wo
// Projects
//

Use cWebView.pkg
Use cWebList.pkg
Use cWebMenuGroup.pkg
Use cWebMenuItem.pkg
Use cWebColumnButton.pkg
Use cWebColumn.pkg
Use ZoomProject.wo

Use cCustomerDataDictionary.dd
Use cProjectTypeDataDictionary.dd
Use cProjectStatusDataDictionary.dd
Use cProjectDataDictionary.dd

Object oSelectProject is a cWebView
    Set psCaption to "Projects"
    Set peWebViewStyle to wvsDrilldown
    Set peViewType to vtSelect
    Set piColumnCount to 12
    Set pbShowCaption to False

    Object oCustomer_DD is a cCustomerDataDictionary
    End_Object 

    Object oProjectType_DD is a cProjectTypeDataDictionary
    End_Object 

    Object oProjectStatus_DD is a cProjectStatusDataDictionary
    End_Object 

    Object oProject_DD is a cProjectDataDictionary
        Set DDO_Server To oProjectType_DD
        Set DDO_Server To oProjectStatus_DD
        Set DDO_Server to oCustomer_DD
        
        // this lets you save a new parent DD record from within child DD
        Set Allow_Foreign_New_Save_State to True
    End_Object 

    Set Main_DD To oProject_DD
    Set Server  To oProject_DD


    Object oList is a cWebList
        Set piColumnSpan to 0
        Set pbServerOnRowClick to True
        Set pbFillHeight to True
        Set piSortColumn to 0
        Set peGrouping to grpAutomatic
        Set peDbGridType to gtAllData

        Object oProjectName is a cWebColumn
            Entry_Item Project.Name
            Set psCaption to "Name"
            Set piWidth to 155
            Set peWordBreak to wbEllipsis
        End_Object 

        Object oCustomerCompany is a cWebColumn
            Entry_Item Customer.Company
            Set psCaption to "Customer"
            Set piWidth to 146
            Set peWordBreak to wbEllipsis
        End_Object 

        Object oProjectTypeDescription is a cWebColumn
            Entry_Item ProjectType.Type
            Set psCaption to "Type"
            Set piWidth to 71
        End_Object 

        Object oProjectStatusDescription is a cWebColumn
            Entry_Item ProjectStatus.Code
            Set psCaption to "Status"
            Set piWidth to 100
        End_Object 

        Object oProjectDescription is a cWebColumn
            Entry_Item Project.Description
            Set psCaption to "Description"
            Set piWidth to 391
            Set peWordBreak to wbEllipsis
        End_Object 

        Object oProjectJiraIssueID is a cWebColumn
            Entry_Item Project.JiraIssueID
            Set psCaption to "Jira Issue"
            Set piWidth to 80
            Set pbFixedWidth to True
            Set pbHidden to True
        End_Object 

        Object oProjectTTCode is a cWebColumn
            Entry_Item Project.TTCode
            Set psCaption to "TT Code"
            Set piWidth to 80
            Set pbFixedWidth to True
            Set pbHidden to True
        End_Object 

        Object oProjectTTSubcode is a cWebColumn
            Entry_Item Project.TTSubcode
            Set psCaption to "TT Subcode"
            Set piWidth to 100
            Set pbFixedWidth to True
            Set pbHidden to True
        End_Object 

        Object oDetailButton is a cWebColumnButton
            Set piWidth to 40
            Set pbFixedWidth to True
            Set pbResizable to False
            Set piListRowSpan to 1
            Set psBtnCssClass to "WebButtonIcon WebIcon_Info"
            Set peAlign to alignRight

            Procedure OnClick
                Send NavigatePath of oList
            End_Procedure
        End_Object 

        WebRegisterPath ntNavigateForward oZoomProject

        Procedure OnRowClick String sRowId
            tWebNavigateData NavigateData
            Get GetNavigateData to NavigateData

            Case Begin
                Case (NavigateData.eNavigateType = nfFromParent)
                    Send NavigateForward of oZoomProject Self
                    Case Break

                Case (NavigateData.eNavigateType = nfFromChild)
                    Send NavigateClose Self
                    Case Break

                Case (NavigateData.eNavigateType = nfFromMain)
                    Send NavigateClose Self
                    Case Break

                Case Else // must be nfUndefined
                    Send NavigateForward of oZoomProject Self

            Case End
        End_Procedure

        Procedure OnGetNavigateForwardData tWebNavigateData ByRef NavigateData Handle hoToView
            Move False to NavigateData.bReadOnly
        End_Procedure

    End_Object 

    Object oActionGroup is a cWebMenuGroup

        Object oSearch is a cWebMenuItem
            Set psCSSClass to "WebPromptMenuItem"
            Set psCaption to "Search"

            Procedure OnClick
                Send Search of oList
            End_Procedure

        End_Object 

        Object oNewButton is a cWebMenuItem
            Set psCSSClass to "WebClearMenuItem"
            Set psCaption to "New"

            WebRegisterPath ntNavigateForward oZoomProject

            Procedure OnClick
                Send NavigatePath
            End_Procedure

            Procedure OnGetNavigateForwardData tWebNavigateData ByRef NavigateData Handle hoToView
                Move True to NavigateData.bNewRecord
            End_Procedure

        End_Object 
    End_Object 

    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
        WebSet pbRender of oNewButton to True
        WebSet pbRender of oDetailButton to True
        
        If (hoInvokingView = oSelectCustomer) Begin
            Send SetBreadcrumbCaption (SFormat("Projects from '%1'", Customer.Company))
        End

        Case Begin
            Case (NavigateData.eNavigateType = nfFromParent)
                // If from parent, this is a constrained drill down
                // If Row select does main-zoom we don't need this
                WebSet pbRender of oDetailButton to False
                
                Case Break

            Case (NavigateData.eNavigateType = nfFromChild)
                // If from child, this is a probably a parent lookup from a Zoom
                Case Break

            Case (NavigateData.eNavigateType = nfFromMain)
                // If from main, this is a probably a main-file lookup from a Zoom
                WebSet pbRender of oDetailButton to False
                Case Break

            Case Else // must be nfUndefined
                // This may be the start of a drilldown query or this may be used for some kind of custom query.
                // If Row select does main-zoom we don't need this
                WebSet pbRender of oDetailButton to False

        Case End

    End_Procedure

    Procedure OnBeforeShow
        Delegate Send HighlightMenu Self
    End_Procedure



End_Object 
